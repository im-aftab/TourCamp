<% layout('./layouts/boilerplate')%>

<div class="row">
    <div class="col-6 offset-3" >
        <div class="card mb-5">
            <img src="<%= destination.image %>" class="card-img-top"  alt="...">
            <div class="card-body">
                <h5 class="card-title"><%= destination.name %></h5>
                <p class="card-text"><%= destination.description %></p>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item">Location : <%= destination.location %></li>
                <li class="list-group-item text-muted">Rating : N/A</li>
                <li class="list-group-item text-muted">Date : <%= destination.date %></li>
            </ul>
            <div class="card-body d-flex">
                <a href="/destinations/<%= destination._id %>/edit" class="card-link btn btn-warning">Edit</a>
                <form class="d-inline ms-auto" action="/destinations/<%= destination._id %>?_method=DELETE" method="POST">
                    <button class="btn btn-danger" type="submit">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>