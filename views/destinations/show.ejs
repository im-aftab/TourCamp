<% layout('./layouts/boilerplate')%>
<h1 style="color:brown; text-align:center;">
    <%= destination.name %><span><sub><u>
                    <%= destination.location %>
                </u></sub></span>
</h1>
<p>
    <%= destination.description %>
</p>
<br><br>
<button><a href="/destinations">Back to All</a></button>
<br>
<button><a href="/destinations/<%= destination._id %>/edit">Edit Destination</a></button>
<span><br><br></span>
<form action="/destinations/<%= destination._id %>?_method=DELETE" method="POST">
    <button type="submit">Delete Destination</button>
</form>