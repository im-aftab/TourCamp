<% layout('./layouts/boilerplate')%>
<h1 Style="color:rgb(170, 13, 13); text-align:center;">Edit <%= destination.name %></h1>

<div class="col-6 offset-3 ">
    <form action="/destinations/<%= destination._id %>?_method=PUT" method="POST" novalidate class="validated-form">
        <div class="mb-3">
            <label for="name" class="form-label" >Name:</label>
            <input type="text" class="form-control" id="name" name="destination[name]" value="<%= destination.name %>" required>
            <div class="invalid-feedback">
                Please enter Name in Title Case
            </div>
            <div class="valid-feedback">
                Looks good! Your text is in Title Case.
            </div>
        </div>
        <div class="mb-3">
            <label for="location" class="form-label">Location:</label>
            <input type="text" class="form-control" id="location" name="destination[location]" value="<%= destination.location %>" required>
            <div class="invalid-feedback">
                Please enter Location in Title Case.
            </div>
            <div class="valid-feedback">
                Looks good!
            </div>
        </div>
        <div class="mb-3">
            <label for="description" class="form-label">Description:</label>
            <textarea class="form-control" id="description" name="destination[description]" rows="1" style="resize: none; overflow:hidden;" required><%= destination.description %></textarea>
            <div class="valid-feedback">
                Looks good!
            </div>
        </div>
        <div class="mb-5">
            <label for="date" class="form-label">Date:</label>
            <input type="date" class="form-control" id="date" name="destination[date]" value="<%= destination.date.toISOString().slice(0, 10) %>"required>
        </div>
        <div class="mb-5">
            <button type="submit" class="btn btn-primary" >Update Destinaiton</button>
        </div>
        
    </form>
</div>

<script src="/scripts/formValidator.js"></script>
<script src="/scripts/textArea.js"></script>