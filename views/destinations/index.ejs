<% layout('./layouts/boilerplate')%>
<h1 class="text-center pb-5">All Destinations</h1>
<div class="container">
  <div class="d-flex flex-wrap gap-3 align-items-stretch">
    <% for (let dest of destinations){ %>
      <div class="card shadow-sm d-flex flex-column" style="width: 18rem;">
        <img src="<%= dest.image %>" class="card-img-top" alt="">
        <div class="card-body d-flex flex-column flex-grow-1">
          <h5 class="card-title"><%= dest.name %></h5>
          <!-- flex-grow-1 makes description fill space -->
          <p class="card-text flex-grow-1"><%= dest.description %></p>
          <!-- mt-auto pushes button to bottom -->
          <a href="/Destinations/<%= dest._id %>" class="btn btn-primary mt-auto">View</a>
        </div>
      </div>
    <% } %>
  </div>
</div>
